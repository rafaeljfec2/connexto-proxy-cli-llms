# Server
HOST=127.0.0.1
PORT=3000

# Logging — see docs/logging.md
LOG_FORMAT=json
LOG_LEVEL=info

# Cursor provider — required for real agent execution and live integration tests.
# Also used when requests omit Authorization / x-api-key.
CURSOR_API_KEY=

# Planned gateway-only auth (NOT enforced by the server yet — see docs/configuration.md)
GATEWAY_API_TOKEN=
