# Server
HOST=127.0.0.1
PORT=3000

# Logging — see docs/logging.md
LOG_FORMAT=json
LOG_LEVEL=info
# LOG_HTTP_PAYLOADS=true
# LOG_HTTP_PAYLOAD_MAX_BYTES=262144
# Max JSON request body for express.json() (default 33554432 = 32 MiB). Required for Codex/Composer tool-heavy payloads.
# GATEWAY_JSON_BODY_LIMIT_BYTES=33554432

# Cursor provider — required for real agent execution and live integration tests.
# Also used when requests omit Authorization / x-api-key.
CURSOR_API_KEY=

# Gateway access — required when HOST is not a loopback address.
# Optional in trusted loopback-only mode. Keep this different from CURSOR_API_KEY.
GATEWAY_API_TOKEN=

# Optional comma-separated list of additional gateway credentials.
# Each distinct value represents a separate consumer identity with isolated
# stored Responses and provider session affinity. Repeated entries are
# deduplicated; values equal to GATEWAY_API_TOKEN or CURSOR_API_KEY are rejected.
# GATEWAY_API_TOKENS=consumer-B-token,consumer-C-token

# Optional comma-separated HTTP(S) origins for browser clients.
# When unset with a loopback HOST, only localhost and loopback IP origins are allowed.
# Remote HOST deployments must list each browser origin explicitly; wildcard values are rejected.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# In-memory & session lifecycle. Defaults: RESPONSE_TTL_MS=3600000 (1h),
# RESPONSE_MAX_ENTRIES=512, SESSION_TTL_MS=86400000 (24h),
# LIFECYCLE_CLEANUP_INTERVAL_MS=60000 (1m).
# RESPONSE_TTL_MS=3600000
# RESPONSE_MAX_ENTRIES=512
# SESSION_TTL_MS=86400000
# LIFECYCLE_CLEANUP_INTERVAL_MS=60000

# Provider session persistence (storage agnostic)
# Drivers: filesystem | memory
# SESSION_STORAGE_DRIVER=filesystem
# SESSION_STORAGE_PATH=/var/lib/connexto-proxy/sessions
# Local pnpm dev (WSL/desktop): prefer a writable path under your home directory:
# SESSION_STORAGE_PATH=/home/user/.connexto-proxy/sessions
# On loopback HOST, if the default /var/lib path is not writable, the API falls back to ~/.connexto-proxy/sessions.
# Host provider directories for container mounts (preserving OAuth credentials)
# HOST_GEMINI_DIR=/home/user/.gemini
# HOST_ANTIGRAVITY_CONFIG_DIR=/home/user/.config/antigravity

# Antigravity storage isolation: dedicated directory for proxy credentials and ACP CLI.
# Defaults to ~/.connexto-proxy/antigravity to prevent clobbering host/WSL Antigravity IDE credentials (~/.gemini).
# ANTIGRAVITY_STORAGE_PATH=/home/user/.connexto-proxy/antigravity

# Cursor local agent working directory (SDK local.cwd). Use with Docker Compose volume at /workspace.
# CURSOR_DEFAULT_WORKING_DIRECTORY=/workspace
# CURSOR_WORKSPACE_HOST_PATH=../connexto-aihub
# CURSOR_CONTAINER_USER=1000:1000
# Chromium for Cursor usage collector (Playwright). Required for Hub «Login web».
CHROMIUM_EXECUTABLE_PATH=/usr/bin/google-chrome
# WSLg headed login: set DISPLAY so the proxy process can open a visible window (often :0).
# DISPLAY=:0
# Grok/x.ai Cloudflare often blocks Playwright's isolated Chrome (--no-sandbox, automation).
# Headed local dev omits --no-sandbox by default; Docker should set CHROMIUM_NO_SANDBOX=true.
# Optional CDP: real desktop Chrome for login UX only (collect still uses cursor.com APIs).
#   Windows (PowerShell): chrome.exe --remote-debugging-port=9222 --user-data-dir="$env:LOCALAPPDATA\Google\Chrome\User Data"
#   WSL proxy: CHROMIUM_CDP_ENDPOINT=http://$(grep nameserver /etc/resolv.conf | awk '{print $2}'):9222
# CHROMIUM_CDP_ENDPOINT=http://172.24.0.1:9222
# CHROMIUM_NO_SANDBOX=false
# CURSOR_USAGE_COLLECT_HEADLESS=false
# Local dev (pnpm dev on WSL/desktop): set false for a visible Chromium window during Cursor OAuth.
# Docker Compose overrides these in docker-compose.yml — do not rely on host CHROMIUM path in the container.
# CURSOR_USAGE_AUTH_HEADLESS=false
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/google-chrome
# CURSOR_USAGE_AUTH_VIEWPORT_WIDTH=1024
# CURSOR_USAGE_AUTH_VIEWPORT_HEIGHT=768
# Usage collect (cursor.com session; grok.com optional legacy)
# CURSOR_USAGE_DASHBOARD_URL=https://cursor.com/dashboard
# CURSOR_USAGE_STATUS_URL=https://cursor.com/api/usage-summary
# CURSOR_USAGE_ANALYTICS_URL=https://cursor.com/api/dashboard/get-current-period-usage
# CURSOR_USAGE_RESPONSE_URL_PATTERN=usage-status|get-user-analytics
