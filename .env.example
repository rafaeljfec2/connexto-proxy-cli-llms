# Server
HOST=127.0.0.1
PORT=3000

# Logging — see docs/logging.md
LOG_FORMAT=json
LOG_LEVEL=info

# Cursor provider — required for real agent execution and live integration tests.
# Also used when requests omit Authorization / x-api-key.
CURSOR_API_KEY=

# Gateway access — required when HOST is not a loopback address.
# Optional in trusted loopback-only mode. Keep this different from CURSOR_API_KEY.
GATEWAY_API_TOKEN=

# Optional comma-separated list of additional gateway credentials.
# Each distinct value represents a separate consumer identity with isolated
# stored Responses and provider session affinity. Repeated entries are
# deduplicated; values equal to GATEWAY_API_TOKEN or CURSOR_API_KEY are rejected.
# GATEWAY_API_TOKENS=consumer-B-token,consumer-C-token

# Optional comma-separated HTTP(S) origins for browser clients.
# When unset with a loopback HOST, only localhost and loopback IP origins are allowed.
# Remote HOST deployments must list each browser origin explicitly; wildcard values are rejected.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# In-memory lifecycle (milliseconds). Defaults: RESPONSE_TTL_MS=3600000 (1h),
# RESPONSE_MAX_ENTRIES=512, SESSION_TTL_MS=86400000 (24h),
# LIFECYCLE_CLEANUP_INTERVAL_MS=60000 (1m).
# RESPONSE_TTL_MS=3600000
# RESPONSE_MAX_ENTRIES=512
# SESSION_TTL_MS=86400000
# LIFECYCLE_CLEANUP_INTERVAL_MS=60000
